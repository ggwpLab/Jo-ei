      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jo_ei_http_requests_in_flight{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "in flight",
          "datasource": {
            "type": "prometheus",
