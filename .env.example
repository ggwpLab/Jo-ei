# Jōei environment configuration — copy to .env and fill in.
#
#   cp .env.example .env
#
# docker-compose passes every variable in .env straight into the jo-ei
# container (docker-compose.yaml lists this file under env_file), so adding a
# JOEI_* variable here is all it takes — nothing to declare in the compose file.
# The real .env is gitignored — keep your secrets out of git.
#
# Any key that appears in config.yaml can be overridden this way: the variable
# name is the key path uppercased with dots as underscores, e.g.
# JOEI_LOGGING_LEVEL for logging.level. A key the file does not contain cannot
# be introduced from the environment — uncomment it in config.yaml first.

# Console users are not configured here: they live in the database. On first
# start Jōei creates user "admin" and logs its temporary password once:
#   docker compose logs jo-ei | grep "initial admin"

# HS256 key that signs console sessions, at least 32 bytes. Leaving this unset
# is fine for a single instance: Jōei generates one on first boot and persists
# it in the database, so sessions survive a restart. Set it explicitly only if
# you need sessions to be shared across replicas, or to survive a database
# reset.
JOEI_CONSOLE_JWT_SECRET=
